# MedFlow Guardian Production Configuration

# ---------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------
# In production, this MUST point to a PostgreSQL instance (e.g., Supabase Postgres)
# Example: postgresql://postgres.xxxxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------------------------------------------------------
# Supabase Configuration
# ---------------------------------------------------------
# Your Supabase project URL (e.g., https://xxxxxx.supabase.co)
SUPABASE_URL=

# Your Supabase Service Role Key (Used exclusively by the backend to bypass RLS and manage buckets securely)
SUPABASE_SERVICE_ROLE_KEY=

# The name of your private Supabase Storage bucket for medical documents
SUPABASE_STORAGE_BUCKET=medical-documents

# Random value of at least 32 characters used by the metrics collector.
OBSERVABILITY_TOKEN=

# ---------------------------------------------------------
# Security & JWT
# ---------------------------------------------------------
# Keep this secret safe in production
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------
# Frontend URLs
# ---------------------------------------------------------
# Used for CORS configuration
CORS_ORIGINS=http://localhost:5174,http://localhost:5175
