# MedFlow Guardian Production Configuration

# ---------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------
# In production, this MUST point to a PostgreSQL instance (e.g., Supabase Postgres)
# Example: postgresql://postgres.xxxxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Backend pytest never inherits DATABASE_URL on a developer workstation. Point
# TEST_DATABASE_URL at a dedicated PostgreSQL database whose name contains "test".
# The repository's docker-compose.test.yml exposes this default on port 55432.
TEST_DATABASE_URL=postgresql://medflow:password@127.0.0.1:55432/medflow_test
# Remote test databases are refused unless this is explicitly enabled.
ALLOW_REMOTE_TEST_DATABASE=false
# Disabling the "test" database-name guard is intentionally separate and should
# almost never be needed.
ALLOW_UNSAFE_TEST_DATABASE=false

# ---------------------------------------------------------
# Supabase Configuration
# ---------------------------------------------------------
# For real Supabase Storage integration in local development:
# 1. Open the Supabase project Dashboard and use the Connect dialog to copy the
#    Project URL (or Settings > API Keys to inspect the project's keys).
# 2. Put the Project URL below, for example https://<project-ref>.supabase.co.
# 3. Put a SERVER-ONLY Supabase secret key (recommended, sb_secret_...) below.
#    The variable name is retained for application compatibility and also accepts
#    a legacy service_role key while older projects are migrated.
# 4. Create a PRIVATE Storage bucket and set its name in
#    SUPABASE_STORAGE_BUCKET. The backend remains the only document access path.
#
# Never commit a real secret/service-role key, expose it through VITE_* variables,
# or ship it to a browser. Supabase secret/service-role credentials bypass RLS.
# If these values are blank/placeholders outside production, StorageService uses
# repository-local medical-document storage and logs that fallback explicitly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medical-documents

# Example local-development values (replace, do not commit):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
# SUPABASE_STORAGE_BUCKET=medical-documents

# Random value of at least 32 characters used by the metrics collector.
OBSERVABILITY_TOKEN=

# ---------------------------------------------------------
# Security & JWT / OIDC
# ---------------------------------------------------------
# Keep this secret safe in production
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OIDC login challenge state/nonce lifetime. The backend enforces a 15–60 minute
# range so MFA-heavy external identity-provider flows are not cut off prematurely.
OIDC_STATE_TTL_SECONDS=900

# ---------------------------------------------------------
# Frontend URLs
# ---------------------------------------------------------
# Used for browser CORS configuration. Keep this explicit in production.
# Local defaults already include patient :5174, doctor :5175, and admin :5176.
FRONTEND_CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176
